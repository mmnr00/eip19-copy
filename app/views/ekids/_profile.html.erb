<% pk = @ekid.pkid %>

<div class="table-responsive">
  <table class="table table-striped table-bordered" width="100%" cellspacing="0">

    <tbody>
      <tr>
        <td style="background-color:#203764" colspan="2"><strong><font color="white"><h2 align="center"><%= @ekid.name.upcase %> (ID: <%= @ekid.id %>)</h2></font></strong></td>
      </tr>
    </tbody>
    <tbody>
      <tr>
        <td style="background-color:#0070C0" ><font color="white">NO MYKID</font></td>
        <td style="background-color:#D9E1F2"><%= "#{@ekid.ic[0..5]}-#{@ekid.ic[6..7]}-#{@ekid.ic[8..12]}" %></td>
      </tr>
      <tr>
        <td style="background-color:#0070C0" ><font color="white">JANTINA</font></td>
        <td style="background-color:#D9E1F2"><%= @ekid.gdr %></td>
      </tr>
      <tr>
        <td style="background-color:#0070C0" ><font color="white">TARIKH LAHIR</font></td>
        <td style="background-color:#D9E1F2"><%= @ekid.dob.strftime('%d-%^b-%Y') %></td>
      </tr>
      <tr>
        <td style="background-color:#0070C0" ><font color="white">UMUR</font></td>
        <td style="background-color:#D9E1F2"><%= "#{@year} Tahun, #{@month} Bulan" %></td>
      </tr>
      <tr>
        <td style="background-color:#0070C0" ><font color="white">SIJIL KELAHIRAN ANAK</font></td>
        <td style="background-color:#D9E1F2">
          <%
            image = @ekid.fotos.where(foto_name: "BIRTH CERT ANAK").first
            if !image.present? && !image.picture.present?
              url = image.picture.url
              desc = "DOKUMEN"
            else
              url = ""
              desc = "TIADA"
            end
          %>
          <a href="<%= url %>" target="_blank"><btn class="badge badge-pill badge-secondary"><%= desc %></btn></a><br>
      
        </td>
      </tr>
      <tr>
        <td style="background-color:#0070C0" ><font color="white">SALINAN AKUAN ANAK ANGKAT</font></td>
        <td style="background-color:#D9E1F2">
