<a style="color: red">*</a> Perlu Dilengkapkan

<div class='row'>
  <div class='col-lg-8 col-12'>
    <%= form_for(@ekid,:html => {multipart: true, class: "form-horizontal", role: "form"}) do |f| %>

      <div class="col-sm-12" style="background-color:blue">
        <font color="white"><h4>MAKLUMAT ANAK</h4></font>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>NAMA ANAK<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :name, class: "form-control", placeholder: "NAMA PENUH SEPERTI DI MYKID", autofocus: true, required: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>NO MYKID<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <% 
              if @ekid.ic.present?
                icval = @ekid.ic
              else
                icval = params[:ic]
              end 
            %>
            <%= f.text_field :ic, class: "form-control", placeholder: "cth: 141201035647 (tiada dash)", autofocus: true, required: true, value: icval, readonly: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>JANTINA<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.select :gdr, options_for_select(["Lelaki", 
                                                  "Perempuan"], 
                                                  selected: @ekid.gdr), 
            {include_blank: "SILA PILIH"}, {required: true} %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>TARIKH LAHIR<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.date_select :dob, 
                              {order:[:day, :month, :year],
                              prompt: { day: 'HARI', month: 'BULAN', year: 'TAHUN' },
                              start_year: 2009,
                              selected: @ekid.dob}, 
                              {required: true} %>
          </div>
        </div>
      </div>

      <br><div class="col-sm-12" style="background-color:blue">
        <font color="white"><h4>MAKLUMAT KELUARGA</h4></font>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>ALAMAT KEDIAMAN<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_area :addr, class: "form-control", placeholder: "Pastikan ada memasukkan poskod, daerah dan negeri", autofocus: true, required: true %>
            Ujian Saringan akan diadakan disekitar lokasi diatas
          </div>
        </div>
      </div>

      
      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>NO TELEFON UNTUK DIHUBUNGI<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :mph, class: "form-control", placeholder: "cth: 01162801556 (tiada dash)", autofocus: true, required: true %>
            Pastikan boleh dihubungi melalui whatsapp
          </div>
        </div>
      </div>

      <!-- ABAH -->
      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>NAMA BAPA<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :fname, class: "form-control", placeholder: "", autofocus: true, required: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>UMUR BAPA (TAHUN)<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.number_field :fage, class: "form-control", placeholder: "", autofocus: true, required: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>NO TELEFON BAPA<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :fph, class: "form-control", placeholder: "cth: 01162801556 (tiada dash)", autofocus: true, required: true %>
            Pastikan boleh dihubungi melalui whatsapp
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>EMAIL BAPA<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.email_field :femail, class: "form-control", placeholder: "", autofocus: true, required: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>TAHAP PENDIDIKAN BAPA<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :fedu, class: "form-control", placeholder: "", autofocus: true, required: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>PEKERJAAN BAPA</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :fworktp, class: "form-control", placeholder: "", autofocus: true %>
          </div>
        </div>
      </div>

      <!-- MAK -->
      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>NAMA IBU<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :mname, class: "form-control", placeholder: "", autofocus: true, required: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>UMUR IBU (TAHUN)<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.number_field :mage, class: "form-control", placeholder: "", autofocus: true, required: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>NO TELEFON IBU<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :mmph, class: "form-control", placeholder: "cth: 01162801556 (tiada dash)", autofocus: true, required: true %>
            Pastikan boleh dihubungi melalui whatsapp
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>EMAIL IBU<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.email_field :memail, class: "form-control", placeholder: "", autofocus: true, required: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>TAHAP PENDIDIKAN IBU<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :medu, class: "form-control", placeholder: "", autofocus: true, required: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>PEKERJAAN IBU<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :mworktp, class: "form-control", placeholder: "", autofocus: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>BILANGAN ADIK BERADIK<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.number_field :sib, class: "form-control", placeholder: "", autofocus: true, required: true %>
            Termasuk anak yang didaftarkan
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-12">
            <strong>ADAKAH IBU/BAPA MEMPUNYAI SEJARAH LEWAT PERKEMBANGAN?<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.select :phist, options_for_select(["Ya", 
                                                  "Tidak"], 
                                                  selected: @ekid.phist), 
            {include_blank: "SILA PILIH"}, {required: true} %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>JIKA YA, SILA NYATAKAN LEWAT PERKEMBANGAN</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :phisttp, class: "form-control", placeholder: "", autofocus: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>PENDAPATAN ISI RUMAH SEBULAN (RM)<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.select :pinc, options_for_select(["Kurang dari 5,000", 
                                                  "5,000 hingga 10,000",
                                                  "Lebih dari 10,000"], 
                                                  selected: @ekid.pinc), 
            {include_blank: "SILA PILIH"}, {required: true} %>
          </div>
        </div>
      </div>

      <br><div class="col-sm-12" style="background-color:blue">
        <font color="white"><h4>MAKLUMAT PERKEMBANGAN ANAK</h4></font>
      </div> 

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-12 col-12">
            <strong>MASALAH PERKEMBANGAN ANAK YANG DIALAMI<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.select :prbtp, options_for_select(["Lambat Bercakap",
                                                    "Lambat Berjalan",
                                                    "Lambat Belajar",
                                                    "Autism",
                                                    "ADHD",
                                                    "Lain-lain"], 
                                                  selected: @ekid.prbtp), 
            {include_blank: "SILA PILIH"}, {required: true} %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-12 col-12">
            <strong>SUDAKAH ANDA MEMBAWA ANAK ANDA BERJUMPA MANA-MANA DOKTOR/TERAPI UNTUK MASALAH TERSEBUT?<a style="color: red">*</a></strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.select :ref, options_for_select(["Ya", 
                                                  "Tidak"], 
                                                  selected: @ekid.ref), 
            {include_blank: "SILA PILIH"}, {required: true} %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>JIKA YA, DIMANAKAH ANAK ANDA DIRUJUK</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :refloc, class: "form-control", placeholder: "", autofocus: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-12 col-12">
            <strong>ADAKAH ANAK ANDA MASIH MEMPUNYAI TEMUJANJI SUSULAN UNTUK MASALAH TERSEBUT?</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.select :reflw, options_for_select(["Ya", 
                                                  "Tidak"], 
                                                  selected: @ekid.reflw), 
            {include_blank: "SILA PILIH"} %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>ADAKAH ANAK ANDA MEMPUNYAI MASALAH PERUBATAN LAIN? SILA NYATAKAN</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_field :prbotmed, class: "form-control", placeholder: "", autofocus: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>ADAKAH ANDA MEMPUNYAI MASALAH SEPANJANG TEMPOH MENGANDUNG DAN SEMASA DILAHIRKAN? SILA NYATAKAN</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_area :prbpreg, class: "form-control", placeholder: "", autofocus: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-12">
            <strong>SILA NYATAKAN LAIN LAIN MAKLUMAT MENGENAI ANAK ANDA</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_area :infot, class: "form-control", placeholder: "", autofocus: true %>
          </div>
        </div>
      </div>

      


        <div class="col-sm-12" style="background-color:blue">
          <font color="white"><h4>KEBENARAN UNTUK PENILAIAN DAN INTERVENSI<a style="color: red">*</a></h4></font>
        </div>

        <%= f.fields_for :agr do |h| %>
          <% $agr.each do |ent| %>
            <div class="form-group"> <!-- name -->
              <div class="row">
                <div class="control-label col-sm-12">
                  <strong><%= ent %></strong>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-12 col-12">
                  <% if ent == "Saya:"  %>
                    <%= h.text_field :"#{ent}", class: "form-control",placeholder: "Nama Ibu/Bapa/Penjaga", value: @ekid.agr[ent], autofocus: true, required: true %>
                  <% elsif ent == "membenarkan pasukan Early Intervention Program untuk menilai dan menjalankan intervensi atau terapi yang diperlukan dan disarankan untuk"  %>
                    <%= h.text_field :"#{ent}", class: "form-control",placeholder: "Nama Anak/Klien", value: @ekid.agr[ent], autofocus: true, required: true %>
                  <% elsif ent == "Tarikh Pengesahan Kebenaran"  %>
                    <%= h.date_field :"#{ent}", class: "form-control",placeholder: "Nama Anak/Klien", value: @ekid.agr[ent], autofocus: true, required: true %>
                  <% elsif ent == "SAYA MENGESAHKAN MAKLUMAT YANG DIBERIKAN DI ATAS ADALAH BENAR"  %>
                    <%= h.select :"#{ent}", options_for_select(["Ya", 
                                                              "Tidak"], 
                                                              selected: @ekid.agr[ent]), 
                        {include_blank: "SILA PILIH"}, {required: true} %><br>
                    <font color="grey" size="2">Pakar kami memerlukan maklumat yang tepat dari ibu-bapa untuk memastikan proses saringan berjalan dengan lancar</font>

                  <% elsif ent == "Saya faham dengan kenyataan dibawah dan memberikan kebenaran untuk menggunakan maklumat diatas untuk mencapai tujuan program:" %>
                    <%= h.select :"#{ent}", options_for_select(["Setuju", 
                                                              "Tidak Setuju"], 
                                                              selected: @ekid.agr[ent]), 
                        {include_blank: "SILA PILIH"}, {required: true} %><br>
                    <font color="grey" size="2">Kami memahami bahawa penggunaan data atau maklumat peribadi adalah dianggap sebagai data peribadi sensiif yang tertakluk di bawah Akta Perlindungan Data Peribadi 2010 (Personal Data Protection Act 2010 - PDPA). SILA AMBIL PERHATIAN bahawa dengan memberikan semua maklumat yang terkandung di sini dan maklumat peribadi lain yang diperolehi daripada sebarang komunikasi dan / atau interaksi di antara pihak kami dan pihak anda (Subjek Data) dengan ini memberi persetujuan kepada MBI untuk mengumpul, memproses dan/atau menggunakan data peribadi untuk tujuan yang berkaitan dengan, atau selaras dengan (Early Intervention Program) di bawah inisiatif Smart Selangor (EIP) yang dikendalikan oleh MBI. MBI bersetuju untuk meyimpan data peribadi yang diterima daripada Subjek Data secara sulit dan mengikut peruntukan-peruntukan di bawah PDPA.</font>
                  <% else %>
                    <%= h.text_field :"#{ent}", class: "form-control",placeholder: "", value: @ekid.agr[ent], autofocus: true, required: true %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>






      <br>
<!-- SUBMIT BUTTON -->
      <div class="form-group">
        <div class="row">
          <div class="col-sm-offset-2 col-sm-10 col-4">
            <%= f.submit :"TERUSKAN",  class: 'btn btn-primary btn-lg' %>
          </div>
        </div>
      </div>
      
    <% end %>

  </div>
</div>

<br><br><br><br><br>